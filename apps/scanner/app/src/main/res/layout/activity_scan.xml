<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Aiming guide: tells the packer where to hold the label. -->
    <View
        android:layout_width="300dp"
        android:layout_height="110dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="120dp"
        android:background="@drawable/bg_reticle" />

    <LinearLayout
        android:id="@+id/banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_margin="14dp"
        android:padding="14dp"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView
            android:id="@+id/bannerText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@color/white"
        android:padding="16dp">

        <TextView
            android:id="@+id/counter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ink2"
            android:textSize="12sp"
            android:text="" />

        <TextView
            android:id="@+id/detected"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="@color/ink"
            android:textSize="26sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/courier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/brand"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Arahkan kamera ke nomor resi."
            android:textColor="@color/ink2"
            android:textSize="12sp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button android:id="@+id/manual"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:text="Input Manual" android:textAllCaps="false"
                android:textColor="@color/ink" android:textSize="13sp" />

            <Button android:id="@+id/history"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:text="Riwayat" android:textAllCaps="false"
                android:textColor="@color/ink" android:textSize="13sp"
                android:layout_marginLeft="8dp" />

            <Button android:id="@+id/logout"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:text="Keluar" android:textAllCaps="false"
                android:textColor="@color/ink2" android:textSize="13sp"
                android:layout_marginLeft="8dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
