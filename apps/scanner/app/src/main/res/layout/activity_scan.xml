<?xml version="1.0" encoding="utf-8"?>
<!--
    The scan screen does one thing, and now looks like it.

    It used to end in six buttons of equal weight, so the two actions a packer
    uses all day sat beside "Keluar" with nothing to tell them apart. The rest
    moved behind a menu; what is left is the camera, what it just read, and
    whether the picture is good enough.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/canvas">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/brand"
        android:paddingLeft="@dimen/space_lg"
        android:paddingRight="@dimen/space_md">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Scan Resi"
            android:textColor="@color/on_brand"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <!-- Today's count belongs up here: it is the one number the packer
             wants at a glance and never has to act on. -->
        <TextView
            android:id="@+id/counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill"
            android:paddingLeft="@dimen/space_md"
            android:paddingRight="@dimen/space_md"
            android:paddingTop="@dimen/space_xs"
            android:paddingBottom="@dimen/space_xs"
            android:textColor="@color/on_brand"
            android:textSize="@dimen/text_small"
            android:text="" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000">

        <androidx.camera.view.PreviewView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_margin="@dimen/space_md"
            android:padding="@dimen/space_md"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                android:id="@+id/bannerText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface"
        android:padding="@dimen/space_lg">

        <!-- Sharpness first. It is the only thing on this panel the packer can
             still do something about while the parcel is in their hand. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/clarityBar"
                style="@style/Meter"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="0" />

            <TextView
                android:id="@+id/clarityText"
                style="@style/Text.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/space_md"
                android:textStyle="bold"
                android:text="Kejelasan —" />
        </LinearLayout>

        <TextView
            android:id="@+id/detected"
            style="@style/Text.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:text="Siap" />

        <TextView
            android:id="@+id/courier"
            style="@style/Text.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/brand"
            android:visibility="gone" />

        <TextView
            android:id="@+id/hint"
            style="@style/Text.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="Arahkan kamera ke barcode pada resi. Tersimpan otomatis." />

        <TextView
            android:id="@+id/liveRead"
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:lineSpacingExtra="1dp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/space_md">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/manual"
                style="@style/Button.Secondary"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Input Manual" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/menu"
                style="@style/Button.Quiet"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/space_sm"
                android:text="Menu Lainnya" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
