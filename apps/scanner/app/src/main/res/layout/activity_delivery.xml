<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/dlPreview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/white"
        android:padding="14dp">

        <TextView
            android:id="@+id/dlStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:textStyle="bold"
            android:text="Siap" />

        <TextView
            android:id="@+id/dlHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ink2"
            android:textSize="12sp"
            android:layout_marginTop="2dp"
            android:text="Arahkan ke barcode resi bahan baku yang datang." />

        <TextView
            android:id="@+id/dlRead"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ink2"
            android:textSize="11sp"
            android:layout_marginTop="6dp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <Button android:id="@+id/dlManual"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:text="Input Resi Manual" android:textAllCaps="false"
                android:textColor="@color/ink" android:textSize="13sp" />

            <Button android:id="@+id/dlClose"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:text="Tutup" android:textAllCaps="false"
                android:textColor="@color/ink2" android:textSize="13sp"
                android:layout_marginLeft="8dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
