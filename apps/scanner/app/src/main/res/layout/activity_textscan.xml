<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/tsPreview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/white"
        android:padding="14dp">

        <TextView
            android:id="@+id/tsStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ink2"
            android:textSize="12sp"
            android:text="Arahkan ke tulisan pada kemasan…" />

        <!-- Bounded so the camera stays visible: the list is for choosing from,
             not for reading everything the label says. -->
        <ListView
            android:id="@+id/tsList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="120dp"
            android:maxHeight="220dp"
            android:layout_marginTop="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <Button android:id="@+id/tsFreeze"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:text="Bekukan" android:textAllCaps="false"
                android:textColor="@color/ink" android:textSize="13sp" />

            <Button android:id="@+id/tsClose"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:text="Tutup" android:textAllCaps="false"
                android:textColor="@color/ink2" android:textSize="13sp"
                android:layout_marginLeft="8dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
